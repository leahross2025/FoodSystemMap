---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { loadData } from '../lib/data.server.js';
import { DISTRICTS } from '../lib/districts.js';
import { SECTORS } from '../lib/sectors.js';
import { summarize } from '../lib/survey.js';

// Rendered on each request, so spreadsheet edits show up within minutes.
export const prerender = false;

const { organizations, report } = await loadData();
const summary = summarize(organizations.filter((org) => org.isSurveyRespondent));

const cards = [
	{ value: summary.respondents, label: 'Survey respondents', note: 'each organization counted once' },
	{ value: report.onMap, label: 'Organizations on the map', note: 'including ones that didn’t take the survey' },
	{ value: summary.sectorsRepresented, label: 'Sectors represented', note: `of ${SECTORS.length} sectors` },
	{
		value: summary.hqDistricts,
		label: 'Districts with respondent HQs',
		note: `of ${Object.keys(DISTRICTS).length} supervisorial districts`,
	},
];

// Charts with many bars span the page, their bars in two columns.
const WIDE = new Set(['sector', 'activities', 'groups']);

const updated = new Date(report.fetchedAt);
const updatedText = Number.isNaN(updated.getTime())
	? ''
	: updated.toLocaleString('en-US', {
			timeZone: 'America/Los_Angeles',
			month: 'short',
			day: 'numeric',
			year: 'numeric',
			hour: 'numeric',
			minute: '2-digit',
			timeZoneName: 'short',
		});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} - Dashboard`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<nav class="navigation">
			<div class="nav-container">
				<a href="/" class="nav-link">← Back to Map</a>
				<h1>Survey Results Dashboard</h1>
			</div>
		</nav>

		<div class="hero-section">
			<div class="hero-logo">
				<a href="https://lacountyfoodsystems.org/" target="_blank" rel="noopener noreferrer">
					<img src="/images/LACOFE_FoodSystems_wht.webp" alt="LA Food Systems" />
				</a>
			</div>
			<p>Results of the Food Systems Stakeholder Survey of organizations across Los Angeles County</p>
		</div>

		<main class="dashboard">
			<section class="summary-cards" aria-label="Summary">
				{
					cards.map((card) => (
						<div class="summary-card">
							<p class="card-value">{card.value}</p>
							<p class="card-title">{card.label}</p>
							<p class="card-subtitle">{card.note}</p>
						</div>
					))
				}
			</section>

			<div class="charts">
				{
					summary.sections.map((section) => (
						<section class:list={['chart', { wide: WIDE.has(section.id) }]} aria-labelledby={`${section.id}-title`}>
							<h2 id={`${section.id}-title`}>{section.title}</h2>
							<p class="chart-subtitle">
								n = {section.n} {section.n === 1 ? 'respondent' : 'respondents'}
								{section.note && ` · ${section.note}`}
							</p>
							{section.n ? (
								<ul class="bars" role="list">
									{section.bars.map((bar) => (
										<li class:list={['bar', { 'write-in': bar.writeIn }]} title={bar.fullText}>
											<span class="bar-label">{bar.label}</span>
											<span class="bar-row">
												{bar.count > 0 && (
													<span class="bar-fill" style={{ '--share': bar.count / section.n, '--bar-color': bar.color }} />
												)}
												<span class="bar-value">
													{bar.count} ({bar.percent}%)
												</span>
											</span>
										</li>
									))}
								</ul>
							) : (
								<p class="no-answers">No answers yet.</p>
							)}
						</section>
					))
				}
			</div>

			<p class="data-note">
				{report.source === 'live' ? 'Live from the survey spreadsheet' : 'Showing saved copy of the survey spreadsheet'}
				{updatedText && ` · updated ${updatedText}`}
			</p>
		</main>

		<Footer />
	</body>
</html>

<style>
	.navigation {
		background: #2d3748;
		color: white;
		padding: 1rem 0;
		position: sticky;
		top: 0;
		z-index: 100;
	}

	.nav-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 20px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 2rem;
	}

	.nav-link {
		color: #90cdf4;
		text-decoration: none;
		font-weight: 500;
		transition: color 0.2s;
	}

	.nav-link:hover {
		color: white;
	}

	.navigation h1 {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 600;
		color: white;
	}

	.hero-section {
		text-align: center;
		padding: 40px 20px;
		background: #383838;
		color: white;
		margin-bottom: 30px;
	}

	.hero-logo {
		margin-bottom: 15px;
	}

	.hero-logo img {
		width: 35%;
		height: auto;
		max-width: 60%;
	}

	.hero-section p {
		font-size: 1.2rem;
		margin: 0 auto;
		max-width: 640px;
		line-height: 1.6;
	}

	.dashboard {
		width: auto;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 20px 40px;
	}

	.summary-cards {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 20px;
		margin-bottom: 30px;
	}

	.summary-card {
		background: white;
		padding: 24px;
		border-radius: 12px;
		box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
		text-align: center;
	}

	.card-value {
		margin: 0 0 8px;
		font-size: 2.5rem;
		font-weight: bold;
		line-height: 1.1;
		color: #2d3748;
	}

	.card-title {
		margin: 0 0 4px;
		font-size: 1.1rem;
		font-weight: 600;
		line-height: 1.3;
		color: #4a5568;
	}

	.card-subtitle {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.4;
		color: #5a6578;
	}

	.charts {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
		align-items: start;
	}

	.chart {
		background: white;
		border-radius: 12px;
		box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
		padding: 24px;
	}

	.chart.wide {
		grid-column: 1 / -1;
	}

	.chart h2 {
		margin: 0 0 4px;
		font-size: 1.3rem;
		font-weight: 600;
		color: #2d3748;
	}

	.chart-subtitle {
		margin: 0 0 20px;
		font-size: 0.9rem;
		line-height: 1.4;
		color: #5a6578;
	}

	.bars {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.chart.wide .bars {
		columns: 2;
		column-gap: 48px;
	}

	.bar {
		break-inside: avoid;
		padding-bottom: 14px;
		line-height: 1.35;
	}

	.bar-label {
		display: block;
		margin-bottom: 4px;
		font-size: 0.95rem;
		color: #2d3748;
	}

	/* Shortened label: the form's full wording shows on hover. */
	.bar[title] .bar-label {
		cursor: help;
		text-decoration: underline dotted #a0aec0;
		text-underline-offset: 3px;
	}

	.bar-row {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	/* Bars share one scale: the full width (less room for the value) is 100% of respondents. */
	.bar-fill {
		flex: none;
		width: calc((100% - 5.5rem) * var(--share));
		height: 14px;
		border-radius: 0 4px 4px 0;
		background: var(--bar-color, #383838);
	}

	.write-in .bar-fill {
		background: #a0aec0;
	}

	.bar-value {
		font-size: 0.85rem;
		color: #4a5568;
		white-space: nowrap;
	}

	.no-answers {
		margin: 0;
		font-size: 0.95rem;
		color: #5a6578;
	}

	.data-note {
		margin: 30px 0 0;
		text-align: center;
		font-size: 0.85rem;
		color: #5a6578;
	}

	@media (max-width: 900px) {
		.summary-cards {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.charts {
			grid-template-columns: minmax(0, 1fr);
		}

		.chart.wide .bars {
			columns: 1;
		}
	}

	@media (max-width: 768px) {
		.nav-container {
			padding: 0 15px;
		}

		.navigation h1 {
			font-size: 1.2rem;
		}

		.hero-section {
			padding: 30px 15px;
			margin-bottom: 25px;
		}

		.hero-section p {
			font-size: 1rem;
			line-height: 1.5;
		}

		.dashboard {
			padding: 0 15px 30px;
		}

		.summary-cards {
			gap: 15px;
		}

		.summary-card {
			padding: 16px 12px;
		}

		.card-value {
			font-size: 2rem;
		}

		.card-title {
			font-size: 1rem;
		}

		.chart {
			padding: 18px 16px;
		}

		.chart h2 {
			font-size: 1.15rem;
		}
	}

	@media (max-width: 480px) {
		.hero-logo img {
			width: 60%;
		}

		.summary-card {
			padding: 14px 10px;
		}

		.card-value {
			font-size: 1.75rem;
		}

		.card-title {
			font-size: 0.9rem;
		}

		.card-subtitle {
			font-size: 0.8rem;
		}
	}
</style>
